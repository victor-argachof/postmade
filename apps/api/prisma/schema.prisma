generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityProvider {
  password
  google
}

enum ChallengePurpose {
  register
  login
  password_reset
  email_change
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum SocialPlatform {
  facebook
  linkedin
  instagram
  tiktok
  youtube
}

enum ChannelConnectionStatus {
  connected
  requires_reauthentication
  unavailable
  disconnected
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  identities       Identity[]
  sessions         Session[]
  memberships      WorkspaceMember[]
  challenges       EmailChallenge[]
  createdTagGroups TagGroup[]        @relation("TagGroupCreator")
  createdChannels  Channel[]         @relation("ChannelCreator")
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
}

model Identity {
  id              String              @id @default(uuid())
  userId          String              @unique
  provider        IdentityProvider
  providerSubject String
  emailVerified   Boolean             @default(false)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential      PasswordCredential?

  @@unique([provider, providerSubject])
}

model PasswordCredential {
  identityId   String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model EmailChallenge {
  id              String           @id @default(uuid())
  purpose         ChallengePurpose
  email           String
  codeHash        String
  attempts        Int              @default(0)
  expiresAt       DateTime
  consumedAt      DateTime?
  lastSentAt      DateTime         @default(now())
  pendingName     String?
  pendingPassword String?
  pendingTimezone String?
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@index([email, purpose])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                   String             @id @default(uuid())
  name                 String
  ownerId              String
  timezone             String
  subscriptionStatus   SubscriptionStatus @default(trialing)
  subscriptionChannels Int                @default(3)
  subscriptionMembers  Int                @default(1)
  trialStartedAt       DateTime           @default(now())
  trialEndsAt          DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  owner                User               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members              WorkspaceMember[]
  tagGroups            TagGroup[]
  channels             Channel[]

  @@index([ownerId])
}

model Channel {
  id                String                  @id @default(uuid())
  workspaceId       String
  platform          SocialPlatform
  providerAccountId String
  displayName       String
  username          String
  avatarUrl         String?
  searchText        String
  connectionStatus  ChannelConnectionStatus @default(connected)
  lastCheckedAt     DateTime?
  connectedAt       DateTime                @default(now())
  disconnectedAt    DateTime?
  createdBy         String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User                    @relation("ChannelCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([workspaceId, platform, providerAccountId])
  @@index([workspaceId, connectionStatus])
  @@index([workspaceId, platform])
  @@index([workspaceId, searchText])
}

model TagGroup {
  id             String    @id @default(uuid())
  workspaceId    String
  name           String
  normalizedName String
  tags           String[]
  tagCount       Int
  searchText     String
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User      @relation("TagGroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}
